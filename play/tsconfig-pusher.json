{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "outDir": "./dist",
    "preserveValueImports": false,
    "baseUrl": ".",                           /* Base directory to resolve non-absolute module names. */
    "paths": {
      "@workadventure/messages": ["../src/ts-proto-generated"]
    }
  },
  "include": [
    "./src",
  ],
  "exclude": [
    "./src/front",
    "./src/svelte.ts",
    "./src/iframe_api.ts",
  ]
}