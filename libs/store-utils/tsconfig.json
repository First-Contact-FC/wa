{
    "compilerOptions": {
      "rootDir": ".",
      "outDir": "dist",
      "target": "ES2020",
      "lib": [
        "es2019",
        "dom"
      ],
      "module": "CommonJS",
      "esModuleInterop": true,
      "strict": true,
      "declaration": true,
      "sourceMap": true,
      "importsNotUsedAsValues": "remove",
      "baseUrl": ".",                           /* Base directory to resolve non-absolute module names. */
      "paths": {
        "@workadventure/messages": ["../../src/ts-proto-generated"]
      },
      "skipLibCheck": true
    }
}
