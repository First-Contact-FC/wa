{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "rootDir": "src",
        "outDir": "dist",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "noImplicitAny": true,
        "moduleResolution": "Node",
        "baseUrl": ".",                           /* Base directory to resolve non-absolute module names. */
        "paths": {
        "@workadventure/messages": ["../../../src/ts-proto-generated"]
        },
        "declaration": true
    },
    "include": ["./src/**/*"],
    "exclude": ["node_modules", "dist"]
}