{
    "compilerOptions": {
      "rootDir": "src",
      "outDir": "dist",
      "baseUrl": ".",                           /* "BaseUrl" : "./" */
      "paths": {
        "@workadventure/messages": ["../../src/ts-proto-generated"]
      },
      "target": "es2020",
      "lib": [
        "es2020",
        "dom"
      ],
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "esModuleInterop": true,
      "strict": true,
      "declaration": true,
      "sourceMap": true,
      "skipLibCheck": true
    }
  }
